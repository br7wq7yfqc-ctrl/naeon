<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.naeon.assets.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/YOUR_USERNAME/Projects/naeon && rclone sync neon:dev ./assets --exclude '.DS_Store' --exclude '*.tmp' --exclude 'Thumbs.db'</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer> <!-- каждые 15 минут -->

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/naeon-assets-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/naeon-assets-sync.err</string>
</dict>
</plist>
