{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGenerations",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::neon/generations/*"]
    },
    {
      "Sid": "PublicReadReleases",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::neon/releases/*"]
    }
  ]
}
