			or guest_j == guest_d or guest_j == guest_e or guest_j == guest_f \
			or guest_j == guest_g or guest_j == guest_h or guest_j == guest_i:
		fails.append("FL-J tenth pip reused FL-A/FL-B/FL-C/FL-D/FL-E/FL-F/FL-G/FL-H/FL-I")
