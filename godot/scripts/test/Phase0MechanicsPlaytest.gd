	var auth_d := ""
	if bt_d.has_method("combat_authority"):
		auth_d = str(bt_d.combat_authority())
	if auth_d != "host":
		fails.append("BT-D combat authority is not host (%s)" % auth_d)
	for d_d in members_d:
		if d_d == null or not is_instance_valid(d_d):
