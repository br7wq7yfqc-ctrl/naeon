	var host: Node3D = null
	var traffic: Node = null
	var dummy: Node3D = null
	var pin0 := str(LayerContext.site_pin_id) if LayerContext else ""
	if P0 == null or not bool(P0.SN_C_OVERLAY):
		fails.append("SN-C P0Slice flag missing")
