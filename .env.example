# NAEON secrets template — copy to .env and fill real values.
# NEVER commit the real .env file!

# --- Tripo 3D ---
TRIPO_API_KEY=tsk_your_key_here
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
# TRIPO_MODEL_VERSION=v2.5-20250123

# --- Yandex Object Storage (bucket: neon) ---
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_BUCKET=neon
YC_STORAGE_ACCESS_KEY=your_key_id_here
YC_STORAGE_SECRET_KEY=your_secret_here
YC_STORAGE_REGION=ru-central1

# Optional
# LOCAL_ASSETS_PATH=./assets
# BLENDER_BIN=/opt/blender/blender
